        // Check digest 2 (SHA256) is set
        assertTrue(address(dnssec.digests(2)) != address(0), "Digest 2 should be set");
        
        // Check digest 253 (dummy) is set
        assertTrue(address(dnssec.digests(253)) != address(0), "Digest 253 should be set");
    }
    
