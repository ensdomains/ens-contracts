    // Test 5: Should reject signatures with non-matching algorithms
    function testShouldRejectSignaturesWithNonMatchingAlgorithms() public {
        // Set time to be within the validity period of the test signature
        vm.warp(1750900000); // Set to time after inception (1750848032) // Set to a time within the signature validity period
        
        // Create proper DNS wire format for root DNSKEY with unsupported algorithm 255
        // baseKeys.rrs.map((rr) => ({ ...rr, data: { ...rr.data, algorithm: 255 }}))
        bytes memory rootRRSetWithBadAlgorithm = hex"0030fd0000000e106880bd4c685bd22004fe00000030000100000e100006010103ff0000";
        bytes memory emptySig = hex"";
        
        DNSSEC.RRSetWithSignature[] memory sets = new DNSSEC.RRSetWithSignature[](1);
        sets[0] = DNSSEC.RRSetWithSignature({
            rrset: rootRRSetWithBadAlgorithm,
            sig: emptySig
        });
        
        vm.expectRevert(abi.encodeWithSignature("NoMatchingProof(bytes)", hex"00"));
        dnssec.verifyRRSet(sets);
    }
    
